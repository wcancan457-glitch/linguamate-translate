# 腾讯云实时 ASR（正式实时转写模式需要）
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_MODEL=16k_zh_large

# 任意 OpenAI 兼容的文本模型，用于将最终中文句子翻为英文。
# 腾讯混元可按官方控制台创建 API Key 后填写；也可替换为其他兼容服务。
TRANSLATION_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
TRANSLATION_API_KEY=
TRANSLATION_MODEL=hunyuan-turbo
