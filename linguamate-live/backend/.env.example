# 服务
PORT=8787
ALLOWED_ORIGIN=http://localhost:3000

# 腾讯云实时语音识别。不要把这三个值发送给浏览器。
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_MODEL=16k_zh_large

# 英文翻译：任意 OpenAI 兼容文本模型。
# 腾讯混元等供应商请在各自控制台创建密钥后填写。
TRANSLATION_BASE_URL=https://tokenhub.tencentmaas.com/v1
TRANSLATION_API_KEY=
TRANSLATION_MODEL=hy-mt2-plus

# 中文语言净化：必须填 TokenHub 已启用的通用对话模型；不要填写 hy-mt2-plus 等翻译专用模型。
# 例如先在 TokenHub 的模型列表中选择可用的低延迟通用模型，再将其准确 ID 填到这里。
CLEANUP_MODEL=

# 阶段 5 截图翻译的全局热键（Electron 主进程读取；仅 Windows 生效）。
# 改成 Electron accelerator 语法，见 https://www.electronjs.org/docs/latest/api/accelerator
# 留空则用默认值 CommandOrControl+Shift+S，即 Ctrl+Shift+S。
# 注意：与录音热键 LINGUAMATE_SHORTCUT（默认 Ctrl+Shift+L）不要设成同一个。
LINGUAMATE_SCREENSHOT_HOTKEY=
